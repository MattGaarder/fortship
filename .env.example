NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-long-random-value
API_KEY=replace-with-a-long-random-value

# The backend, not the Excel script, decides which authenticated mailbox drafts
# the report. Set to gmail for the existing Gmail route or microsoft for Outlook.
EMAIL_PROVIDER=microsoft
REPORT_RECIPIENTS=operations@example.com;client@example.com
DAILY_REPORT_SUBJECT=Daily Shipping Report

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/google/callback

# Use the company's Entra tenant ID in production. Do not use "consumers" for a
# company Microsoft 365 mailbox.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Use a tenant GUID for a Fortship-only setup, or "common" for work/school and
# personal Microsoft accounts such as @outlook.com.
MICROSOFT_AUTHORITY_TENANT=common
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:3000/microsoft/callback
# Required only after more than one account has authenticated. Use the Outlook
# mailbox that should own the operational drafts.
MICROSOFT_SENDING_ACCOUNT=

# Leave false when staff should review the Outlook draft before sending it.
MICROSOFT_ALLOW_SEND=false
